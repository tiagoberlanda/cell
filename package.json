{
  "name": "cell", "private": true, "version": "0.10.0", "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @cell/web",
    "build": "npm run build -w @cell/web",
    "check": "tsc --noEmit && npm run check -w @cell/web",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "api": "node --import tsx apps/server/src/api.ts",
    "worker": "node --import tsx apps/server/src/worker.ts",
    "migrate": "node --import tsx apps/server/src/migrate.ts",
    "admin": "node --import tsx apps/server/src/admin.ts",
    "icons": "node scripts/generate-icons.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2", "@fastify/multipart": "^9.3.0", "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/sdk": "^1.25.0", "argon2": "^0.44.0", "cron-parser": "^5.4.0",
    "dotenv": "^17.2.3", "drizzle-orm": "^0.45.2", "fastify": "^5.6.2", "mammoth": "^1.11.0",
    "pdf-parse": "^1.1.1", "pg": "^8.16.3", "pg-boss": "^12.5.0", "zod": "^4.1.12"
  },
  "devDependencies": { "@types/node": "^24.10.0", "@types/pg": "^8.15.6", "tsx": "^4.20.6", "typescript": "^5.9.3", "@playwright/test": "^1.56.1" }
}
