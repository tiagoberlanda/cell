{
  "name": "cell",
  "private": true,
  "version": "0.30.17",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @cell/web",
    "build": "npm run build -w @cell/web",
    "check": "tsc --noEmit && npm run check -w @cell/web",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node scripts/test-db.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "backup": "node --import tsx apps/server/src/backup-cli.ts",
    "api": "node --import tsx apps/server/src/api.ts",
    "worker": "node --import tsx apps/server/src/worker.ts",
    "migrate": "node --import tsx apps/server/src/migrate.ts",
    "admin": "node --import tsx apps/server/src/admin.ts",
    "icons": "node scripts/generate-icons.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.3.0",
    "@fastify/rate-limit": "^10.3.0",
    "@modelcontextprotocol/sdk": "^1.25.0",
    "argon2": "^0.44.0",
    "cron-parser": "^5.4.0",
    "docx": "^9.11.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.2",
    "mammoth": "^1.11.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "pg-boss": "^12.5.0",
    "pptxgenjs": "^4.0.1",
    "ssh2": "^1.17.0",
    "web-push": "^3.6.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.15.6",
    "@types/ssh2": "^1.15.6",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
