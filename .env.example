# Modelo do .env. O scripts\setup.ps1 cria o .env sozinho, com senhas e chaves aleatórias;
# copie daqui só se for montar o arquivo à mão. Depois de mudar o .env, rode .\scripts\deploy.ps1.

# --- Obrigatórias ---------------------------------------------------------------------------
# Senha do PostgreSQL (o banco só é acessível de dentro do Docker). Use um valor aleatório longo.
POSTGRES_PASSWORD=
# Chave que cifra tokens e credenciais no banco: 64 caracteres hexadecimais.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Não perca: sem ela, os segredos salvos (tokens, senhas de SSH) não abrem mais.
SECRET_KEY=

# Endereços pelos quais o Cell é aberto, separados por vírgula (IP da rede, domínio, localhost).
CELL_HOST=192.168.0.10, localhost
# Endereço usado quando o navegador abre o Cell pelo IP (normalmente o primeiro de CELL_HOST).
CELL_DEFAULT_SNI=192.168.0.10
# Os mesmos endereços, com https://. O primeiro é usado como retorno ao conectar aplicativos (OAuth).
APP_ORIGIN=https://192.168.0.10,https://localhost

# --- Provedor de modelos (valores iniciais; também ajustáveis em Configurações → 9router) ---
# host.docker.internal é o próprio computador, visto de dentro do Docker.
NINEROUTER_BASE_URL=http://host.docker.internal:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_DEFAULT_MODEL=

# --- Opcionais -------------------------------------------------------------------------------
# Cell Host (comandos no computador). Gravados pelo scripts\host.ps1; não preencha à mão.
CELL_HOST_URL=
CELL_HOST_TOKEN=
# Cloudflare Tunnel: segredo enviado no cabeçalho X-Cell-Proxy-Secret para o Cell confiar no IP real do visitante.
CELL_PROXY_SECRET=
# Alternativa ao segredo: redes (CIDR) dos proxies confiáveis, separadas por vírgula.
TRUSTED_PROXIES=
